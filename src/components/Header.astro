---
// src/components/Header.astro
const pathname = new URL(Astro.request.url).pathname;

const isActive = (path: string) => {
  if (path === '/' && pathname === '/') return true;
  if (path !== '/' && pathname.startsWith(path)) return true;
  return false;
};
---

<header class="w-full bg-[#eae8e4] text-[#121212] px-6 md:px-12 py-5 font-mono-meta text-xs select-none relative z-50 flex items-center justify-between border-b border-[#d3d0c9]/40">
  
  {/* LEFT GROUP: Logo Stamp + Menu Links */}
  <div class="flex items-center gap-10 md:gap-16">
    {/* Studio Stamp Box */}
    <a href="/" class="flex flex-col items-center justify-center border-2 border-[#121212] p-1.5 w-12 h-14 bg-white shadow-xs hover:scale-105 transition-transform">
      <span class="font-black text-[9px] tracking-tighter leading-none">STUDIO</span>
      <span class="text-[7px] text-[#73716b] font-mono tracking-widest mt-0.5">ARCH</span>
      <span class="text-[6px] text-[#73716b] mt-0.5">TOKYO</span>
    </a>

    {/* Horizontal Menu Group */}
    <div class="flex items-center gap-6 md:gap-10">
      <span class="text-[#73716b] hidden sm:inline">Menu</span>
      <nav class="flex items-center gap-4 md:gap-8 font-bold uppercase tracking-tight text-xs md:text-sm">
        <a 
          href="/" 
          class={`transition-colors hover:opacity-50 ${isActive('/') && !isActive('/work') && !isActive('/about') ? 'text-[#121212] underline underline-offset-4' : 'text-[#73716b]'}`}
        >
          {isActive('/') && !isActive('/work') && !isActive('/about') ? '→ ' : ''}Work
        </a>
        <a 
          href="/about" 
          class={`transition-colors hover:opacity-50 ${isActive('/about') ? 'text-[#121212] underline underline-offset-4' : 'text-[#73716b]'}`}
        >
          {isActive('/about') ? '→ ' : ''}About
        </a>
        <a 
          href="/work" 
          class={`transition-colors hover:opacity-50 ${isActive('/work') ? 'text-[#121212] underline underline-offset-4' : 'text-[#73716b]'}`}
        >
          {isActive('/work') ? '→ ' : ''}Archive
        </a>
      </nav>
    </div>
  </div>

  {/* CENTER / RIGHT GROUP: Audio & Global Time */}
  <div class="hidden lg:flex items-center gap-12 text-[#73716b] text-[11px]">
    <div>
      Audio <span class="text-[#121212] font-semibold">Off —</span>
    </div>
    <div class="text-right">
      <span class="block text-[#121212] font-semibold">Working globally</span>
      <span>TOKYO / ZÜRICH, 12:44</span>
    </div>
  </div>

  {/* FAR RIGHT: Inquiries Link */}
  <div class="text-right">
    <a 
      href="mailto:inquiries@studioarch.com" 
      class="text-[11px] md:text-xs font-bold text-[#121212] hover:underline underline-offset-2"
    >
      For inquiries <span class="font-normal text-[#73716b]">hello@studioarch.com</span>
    </a>
  </div>

</header>