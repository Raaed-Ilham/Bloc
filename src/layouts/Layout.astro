---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "STUDIO ARCH.® — Architecture & Masterplanning",
  description = "Selected architectural works, spatial designs, and urban masterplanning."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-[#eae8e4] text-[#121212] min-h-screen antialiased selection:bg-[#121212] selection:text-[#eae8e4]">
    <slot />
  </body>
</html>